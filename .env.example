# Packaging Studio configuration
# Copy this to ".env" and fill in your key.
# You can also just enter it in the app under Settings; the file is then
# created for you.
#
# This file stays on your machine. Never upload it, never commit it.

# ---- Required ---------------------------------------------------------
# Get one at https://console.anthropic.com under "API Keys"
ANTHROPIC_API_KEY=

# Which model the agent uses.
#   claude-opus-4-5-20251101     best design judgement, priciest
#   claude-sonnet-4-5-20250929   good balance
#   claude-haiku-4-5-20251001    fast and cheap
ANTHROPIC_MODEL=claude-opus-4-5-20251101

# ---- Optional: image generation ---------------------------------------
# Claude does not generate pixel images. The studio works in vectors, which
# is the better answer for print. Add a key here if you also want
# photographic motifs. Either one will do; Gemini wins if both are set.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# ---- Server -----------------------------------------------------------
PORT=8777

# How many tool steps the agent may take per message.
MAX_AGENT_STEPS=24
