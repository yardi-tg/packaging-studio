# Packaging Studio configuration
# Copy this to ".env" and fill in your key.
# You can also just enter it in the app under Settings; the file is then
# created for you.
#
# This file stays on your machine. Never upload it, never commit it.

# ---- Required ---------------------------------------------------------
# Get one at https://console.anthropic.com under "API Keys"
ANTHROPIC_API_KEY=

# Which model the agent uses.
#   claude-opus-5-5     best design judgement (recommended)
#   claude-fable-5-2    most capable, priciest
#   claude-sonnet-5-5   good balance
#   claude-haiku-5-5    very fast and cheap
ANTHROPIC_MODEL=claude-opus-5-5

# How hard the model thinks: medium, high (recommended) or max.
# Thinking is billed as output, so higher costs more.
ANTHROPIC_EFFORT=high

# Only change this if your traffic goes through a proxy.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---- Recommended: Gemini, for the Photos tab --------------------------
# Claude does not generate pixel images. Gemini takes the 3D render of your
# finished package and puts it into a real scene -- held in a hand, on a
# marble counter, on a shelf -- without changing the design.
# Free tier at https://aistudio.google.com
GEMINI_API_KEY=

# Leave these alone. "Test connection" in the app fills them in with the
# best image model your account can reach and the way your key signs in.
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GEMINI_AUTH=

# ---- Alternative: OpenAI ----------------------------------------------
# Generates motifs, but cannot do the Photos tab: that needs a model which
# edits the render rather than inventing a new box.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# ---- Server -----------------------------------------------------------
PORT=8777

# How many tool steps the agent may take per message.
MAX_AGENT_STEPS=24

# ---- Website mode only (Vercel, or `python3 server.py --hosted`) --------
# Set these in the host's environment settings, not in a file.
# ACCESS_CODES=6767                  the code(s) people type to get in
# ALLOWED_MODELS=claude-sonnet-5-5,claude-haiku-5-5
# HOSTED_MODEL=claude-sonnet-5-5     the default choice
# HOSTED_EFFORTS=medium,high
